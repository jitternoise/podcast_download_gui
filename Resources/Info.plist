<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>PodcastDownloader</string>
    <key>CFBundleIdentifier</key>
    <string>com.jitternoise.podcastdownloader</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Podcast Downloader</string>
    <key>CFBundleDisplayName</key>
    <string>Podcast Downloader</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.music</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- feed:// podcast:// pcast:// links from Safari and other apps open in the Search tab. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>Podcast feed</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>feed</string>
                <string>podcast</string>
                <string>pcast</string>
                <string>itms-pcast</string>
            </array>
        </dict>
    </array>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>OPML subscription list</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.xml</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>opml</string>
            </array>
        </dict>
    </array>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 jitternoise</string>
    <!-- Shown in the macOS permission prompt if the user keeps podcasts in a protected folder. -->
    <key>NSDownloadsFolderUsageDescription</key>
    <string>Podcast Downloader saves episodes to the folder you choose.</string>
    <key>NSDocumentsFolderUsageDescription</key>
    <string>Podcast Downloader saves episodes to the folder you choose.</string>
    <key>NSDesktopFolderUsageDescription</key>
    <string>Podcast Downloader saves episodes to the folder you choose.</string>
    <key>NSRemovableVolumesUsageDescription</key>
    <string>Podcast Downloader saves episodes to the folder you choose.</string>
    <key>NSNetworkVolumesUsageDescription</key>
    <string>Podcast Downloader saves episodes to the folder you choose.</string>
    <!-- Many podcast hosts still serve feeds and audio over plain http. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
</dict>
</plist>
